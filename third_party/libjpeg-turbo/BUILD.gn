import("../../gn/skia.gni")

declare_args() {
  skia_use_system_libjpeg_turbo = is_official_build && !is_canvaskit
  libjpeg_turbo_dir = "//third_party/externals/libjpeg-turbo"
}

import("../third_party.gni")

if (skia_use_system_libjpeg_turbo) {
  system("libjpeg") {
    libs = [ "jpeg" ]
  }
} else {
  source_set("libjpeg_headers") {
    sources = [
      "$libjpeg_turbo_dir/src/jconfig.h",
      "$libjpeg_turbo_dir/src/jdct.h",
      "$libjpeg_turbo_dir/src/jinclude.h",
      "$libjpeg_turbo_dir/src/jmorecfg.h",
      "$libjpeg_turbo_dir/src/jpeglib.h",
      "$libjpeg_turbo_dir/src/jpeglibmangler.h",
    ]
  }

  # Based on
  # https://github.com/libjpeg-turbo/libjpeg-turbo/blob/20ade4de/CMakeLists.txt#L605
  #
  # Starting in 3.x, libjpeg-turbo supports runtime-selectable precision.
  # This requires compiling some source sets multiple times, with different
  # BITS_IN_JSAMPLE defines (16, 12, and the default 8), to generate precision-
  # specific symbols (e.g. jpeg16_read_scanlines vs jpeg12_read_scanlines vs
  # jpeg_read_scanlines).

  libjpeg16_sources = [
    "$libjpeg_turbo_dir/src/jcapistd.c",
    "$libjpeg_turbo_dir/src/jccolor.c",
    "$libjpeg_turbo_dir/src/jcdiffct.c",
    "$libjpeg_turbo_dir/src/jclossls.c",
    "$libjpeg_turbo_dir/src/jcmainct.c",
    "$libjpeg_turbo_dir/src/jcprepct.c",
    "$libjpeg_turbo_dir/src/jcsample.c",
    "$libjpeg_turbo_dir/src/jdapistd.c",
    "$libjpeg_turbo_dir/src/jdcolor.c",
    "$libjpeg_turbo_dir/src/jddiffct.c",
    "$libjpeg_turbo_dir/src/jdlossls.c",
    "$libjpeg_turbo_dir/src/jdmainct.c",
    "$libjpeg_turbo_dir/src/jdpostct.c",
    "$libjpeg_turbo_dir/src/jdsample.c",
    "$libjpeg_turbo_dir/src/jutils.c",
  ]

  libjpeg12_sources = libjpeg16_sources + [
                        "$libjpeg_turbo_dir/src/jccoefct.c",
                        "$libjpeg_turbo_dir/src/jcdctmgr.c",
                        "$libjpeg_turbo_dir/src/jdcoefct.c",
                        "$libjpeg_turbo_dir/src/jddctmgr.c",
                        "$libjpeg_turbo_dir/src/jdmerge.c",
                        "$libjpeg_turbo_dir/src/jfdctfst.c",
                        "$libjpeg_turbo_dir/src/jfdctint.c",
                        "$libjpeg_turbo_dir/src/jidctflt.c",
                        "$libjpeg_turbo_dir/src/jidctfst.c",
                        "$libjpeg_turbo_dir/src/jidctint.c",
                        "$libjpeg_turbo_dir/src/jidctred.c",
                        "$libjpeg_turbo_dir/src/jquant1.c",
                        "$libjpeg_turbo_dir/src/jquant2.c",
                      ]

  libjpeg_sources = libjpeg12_sources + [
                      "$libjpeg_turbo_dir/src/jaricom.c",
                      "$libjpeg_turbo_dir/src/jcapimin.c",
                      "$libjpeg_turbo_dir/src/jcarith.c",
                      "$libjpeg_turbo_dir/src/jchuff.c",
                      "$libjpeg_turbo_dir/src/jcicc.c",
                      "$libjpeg_turbo_dir/src/jcinit.c",
                      "$libjpeg_turbo_dir/src/jclhuff.c",
                      "$libjpeg_turbo_dir/src/jcmarker.c",
                      "$libjpeg_turbo_dir/src/jcmaster.c",
                      "$libjpeg_turbo_dir/src/jcomapi.c",
                      "$libjpeg_turbo_dir/src/jcparam.c",
                      "$libjpeg_turbo_dir/src/jcphuff.c",
                      "$libjpeg_turbo_dir/src/jctrans.c",
                      "$libjpeg_turbo_dir/src/jdapimin.c",
                      "$libjpeg_turbo_dir/src/jdarith.c",
                      "$libjpeg_turbo_dir/src/jdatadst.c",
                      "$libjpeg_turbo_dir/src/jdatasrc.c",
                      "$libjpeg_turbo_dir/src/jdhuff.c",
                      "$libjpeg_turbo_dir/src/jdicc.c",
                      "$libjpeg_turbo_dir/src/jdinput.c",
                      "$libjpeg_turbo_dir/src/jdlhuff.c",
                      "$libjpeg_turbo_dir/src/jdmarker.c",
                      "$libjpeg_turbo_dir/src/jdmaster.c",
                      "$libjpeg_turbo_dir/src/jdphuff.c",
                      "$libjpeg_turbo_dir/src/jdtrans.c",
                      "$libjpeg_turbo_dir/src/jerror.c",
                      "$libjpeg_turbo_dir/src/jfdctflt.c",
                      "$libjpeg_turbo_dir/src/jmemmgr.c",
                      "$libjpeg_turbo_dir/src/jmemnobs.c",
                      "$libjpeg_turbo_dir/src/jpeg_nbits.c",
                    ]

  static_library("libjpeg16") {
    sources = libjpeg16_sources

    defines = [
      "NO_GETENV",
      "NO_PUTENV",
      "BITS_IN_JSAMPLE=16",
    ]

    public_deps = [ ":libjpeg_headers" ]
  }

  static_library("libjpeg12") {
    sources = libjpeg12_sources

    defines = [
      "NO_GETENV",
      "NO_PUTENV",
      "BITS_IN_JSAMPLE=12",
    ]

    public_deps = [ ":libjpeg_headers" ]
  }

  third_party("libjpeg") {
    public_include_dirs = [
      ".",
      "$libjpeg_turbo_dir",
      "$libjpeg_turbo_dir/src",
    ]

    defines = [
      "TURBO_FOR_WINDOWS",

      # Add support for arithmetic encoding (C_) and decoding (D_).
      # This matches Android. Note that such JPEGs are likely rare, given lack of
      # support by major browsers.
      "C_ARITH_CODING_SUPPORTED=1",
      "D_ARITH_CODING_SUPPORTED=1",
    ]

    if (!is_win || is_clang) {
      defines += [ "USE_CLZ_INTRINSIC" ]  # Cuts a 64K table.
    }

    sources = libjpeg_sources

    public_deps = [
      ":libjpeg12",
      ":libjpeg16",
      ":libjpeg_headers",
    ]

    if (!is_win && (current_cpu == "arm" || current_cpu == "arm64")) {
      defines += [
        "NEON_INTRINSICS",
        "WITH_SIMD",
      ]
      sources += [
        "$libjpeg_turbo_dir/simd/arm/jccolor-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jcgray-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jcphuff-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jcsample-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jdcolor-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jdmerge-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jdsample-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jfdctfst-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jfdctint-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jidctfst-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jidctint-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jidctred-neon.c",
        "$libjpeg_turbo_dir/simd/arm/jquanti-neon.c",
      ]
      include_dirs = [ "$libjpeg_turbo_dir/simd/arm" ]
      if (current_cpu == "arm") {
        sources += [
          "$libjpeg_turbo_dir/simd/arm/aarch32/jchuff-neon.c",
          "$libjpeg_turbo_dir/simd/arm/aarch32/jsimd.c",
        ]
      } else if (current_cpu == "arm64") {
        sources += [
          "$libjpeg_turbo_dir/simd/arm/aarch64/jchuff-neon.c",
          "$libjpeg_turbo_dir/simd/arm/aarch64/jsimd.c",
        ]
      }
    }
  }
}
