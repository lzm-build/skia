import("../third_party.gni")

declare_args() {
  libavif_dir = "//third_party/externals/libavif"
}

third_party("libavif") {
  deps = [
    "//third_party/libgav1",
    "//third_party/libyuv",
  ]

  public_include_dirs = [
    ".",
    "$libavif_dir/include",
  ]

  include_dirs = [ "$libavif_dir" ]

  defines = [
    "AVIF_CODEC_LIBGAV1=1",
    "AVIF_LIBYUV_ENABLED=1",
  ]

  sources = [
    "$libavif_dir/src/alpha.c",
    "$libavif_dir/src/avif.c",
    "$libavif_dir/src/codec_libgav1.c",
    "$libavif_dir/src/colr.c",
    "$libavif_dir/src/diag.c",
    "$libavif_dir/src/exif.c",
    "$libavif_dir/src/gainmap.c",
    "$libavif_dir/src/io.c",
    "$libavif_dir/src/mem.c",
    "$libavif_dir/src/obu.c",
    "$libavif_dir/src/rawdata.c",
    "$libavif_dir/src/read.c",
    "$libavif_dir/src/reformat.c",
    "$libavif_dir/src/reformat_libsharpyuv.c",
    "$libavif_dir/src/reformat_libyuv.c",
    "$libavif_dir/src/scale.c",
    "$libavif_dir/src/stream.c",
    "$libavif_dir/src/utils.c",
    "$libavif_dir/src/write.c",
  ]
}
